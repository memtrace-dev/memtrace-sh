---
import Layout from '../layouts/Layout.astro';
import StrataCanvas from '../components/StrataCanvas.astro';
import DepthGauge from '../components/DepthGauge.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import Model from '../components/Model.astro';
import Lifecycle from '../components/Lifecycle.astro';
import Record from '../components/Record.astro';
import Surface from '../components/Surface.astro';
import Install from '../components/Install.astro';
import Footer from '../components/Footer.astro';
---

<Layout>
  <StrataCanvas />
  <DepthGauge />
  <Nav />
  {/* The left inset is the gauge's margin. Content never runs under it. */}
  <main id="main" class="relative z-10 lg:pl-[4.5rem] xl:pl-[6.5rem]">
    <Hero />
    <Model />
    <Lifecycle />
    <Record />
    <Surface />
    <Install />
  </main>
  <Footer />
</Layout>
