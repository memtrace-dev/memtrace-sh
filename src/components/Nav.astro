---
import Logo from './Logo.astro';
const repo = 'https://github.com/varve-sh/varve';
---

<header
  data-nav
  class="fixed inset-x-0 top-0 z-50 transition-[height,background-color,border-color,backdrop-filter] duration-500 [--h:5rem] [&.is-stuck]:[--h:3.75rem] h-[var(--h)] border-b border-transparent [&.is-stuck]:border-line [&.is-stuck]:bg-bg/75 [&.is-stuck]:backdrop-blur-xl"
>
  {/* The left inset matches main's, so the wordmark sits on the same
      vertical as the hero label rather than floating over the gauge. */}
  <nav
    class="mx-auto flex h-full max-w-[1500px] items-center justify-between gap-6 px-5 sm:px-8 lg:ml-[4.5rem] xl:ml-[6.5rem]"
  >
    <a href="/" class="group flex items-center gap-2.5 text-accent-text" aria-label="varve, home">
      <Logo class="h-6 w-6 shrink-0" animate />
      <span class="font-mono text-[15px] font-medium tracking-tight text-text">varve</span>
    </a>

    <div class="flex items-center gap-1 sm:gap-2">
      <a
        href={`${repo}#readme`}
        class="hidden rounded-full px-3 py-2 text-sm text-muted transition-colors hover:text-text sm:block"
      >
        Docs
      </a>
      <a
        href={repo}
        rel="noopener"
        class="hidden items-center gap-1.5 rounded-full px-3 py-2 text-sm text-muted transition-colors hover:text-text sm:flex"
      >
        <i class="ph ph-github-logo text-base" aria-hidden="true"></i>GitHub
      </a>

      <button
        id="theme-toggle"
        type="button"
        class="grid h-9 w-9 place-items-center rounded-full text-muted transition-colors hover:text-text"
        aria-label="Switch between light and dark"
      >
        <i class="ph ph-sun text-lg" id="icon-sun" aria-hidden="true"></i>
        <i class="ph ph-moon text-lg hidden" id="icon-moon" aria-hidden="true"></i>
      </button>

      <a
        href="#install"
        class="group relative overflow-hidden rounded-full bg-accent px-4 py-2 text-sm font-medium text-accent-ink transition-colors duration-300 hover:bg-clay hover:text-bg sm:px-5"
      >
        Install
      </a>
    </div>
  </nav>
</header>

<script>
  const root = document.documentElement;
  const btn = document.getElementById('theme-toggle');
  const sun = document.getElementById('icon-sun');
  const moon = document.getElementById('icon-moon');

  const sync = () => {
    const dark = root.classList.contains('dark');
    // Show the icon for the mode the click will take you TO.
    sun?.classList.toggle('hidden', !dark);
    moon?.classList.toggle('hidden', dark);
  };

  sync();
  btn?.addEventListener('click', () => {
    const dark = root.classList.toggle('dark');
    localStorage.setItem('theme', dark ? 'dark' : 'light');
    sync();
    window.dispatchEvent(new CustomEvent('theme:change'));
  });
</script>
